# Environment for `docker compose` only. The k8s deployment sets its env in
# k8s/claude-proxy.yaml instead, and a local `python -m claude_proxy` run needs
# nothing here beyond CLAUDE_PROXY_DATA_DIR.

# Tailscale node IP that the published ports bind to (see docker-compose.yml).
TAILSCALE_IP=100.x.x.x

# Admin console HTTP Basic auth. Auth is enabled *only* when ADMIN_PASSWORD is
# non-empty; leave it empty and every admin route is open to anyone who can
# reach the port (the app logs a warning at startup). ADMIN_USER defaults to
# `admin`. /metrics is exempt from auth either way so Prometheus can scrape it.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Optional; the defaults below are what the code uses if unset. ---
# CLAUDE_PROXY_DATA_DIR=/app/data          # base dir for everything below
# CLAUDE_PROXY_DB=$DATA_DIR/claude_proxy.db
# CLAUDE_PROXY_AUDIT_DB=$DATA_DIR/audit.db # separate file; audit writes dwarf the rest
# CLAUDE_PROXY_PRICING_CACHE=$DATA_DIR/model_prices.json
# CLAUDE_PROXY_UPSTREAM=https://api.anthropic.com
# PROXY_PORT=8080
# ADMIN_PORT=8090
# PROXY_MAX_CONNECTIONS=256                # upstream httpx pool
# PROXY_MAX_KEEPALIVE=128
# PROXY_DRAIN_LEAD=5                       # seconds of failing readiness before we stop accepting
# PROXY_DRAIN_TIMEOUT=90                   # seconds to let in-flight requests finish
